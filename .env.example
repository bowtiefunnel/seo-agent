# ── Trigger.dev ─────────────────────────────────────────────────────────────
# This is currently unlinked from any Trigger.dev project — create one
# (dashboard → New Project) and fill these in before `npm run dev` / `deploy`.
TRIGGER_PROJECT_REF=proj_replace_me
TRIGGER_SECRET_KEY=tr_dev_replace_me

# ── OpenRouter — LLM for fix generation + evaluation ─────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace_me
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o

# ── Slack — HITL review surface (Approve/Deny the weekly fix cards) ──────────
SLACK_BOT_TOKEN=xoxb-replace_me
SLACK_REVIEW_CHANNEL=C0replace_me

# ── Supabase — projects, cards, audit log, report storage ────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
REPORTS_BUCKET=reports
REPORT_URL_TTL_SECONDS=604800

# ── DataForSEO — OnPage audit, Lighthouse CWV, keyword-gap, backlinks ────────
DATAFORSEO_LOGIN=replace_me
DATAFORSEO_PASSWORD=replace_me
DATAFORSEO_LOCATION=United States
DATAFORSEO_LANGUAGE=English

# ── Fallback CWV source if DataForSEO Lighthouse is bot-blocked ──────────────
PAGESPEED_API_KEY=replace_me

# ── Langfuse (optional — observability/tracing) ──────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Brand voice (used in the LLM system preamble) ────────────────────────────
BRAND_NAME=Acme
